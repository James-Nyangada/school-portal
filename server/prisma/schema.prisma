generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FINANCE
  TEACHER
  STUDENT
  PARENT
}

enum Status {
  ACTIVE
  PENDING_ACTIVATION
  PENDING_INVITE
  SUSPENDED
  LOCKED
  COMPLETED
  TRANSFERRED
}

enum PaymentMethod {
  MPESA
  BANK
  CASH
}

enum GradeStatus {
  DRAFT
  PUBLISHED
  PENDING_APPROVAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String
  role            Role
  status          Status    @default(ACTIVE)
  
  // Specific to students
  admissionNumber String?   @unique
  nemisNumber     String?   @unique
  birthCertificateUrl String?
  reportCardUrl       String?
  passportPhotoUrl    String?
  
  // Common fields
  firstName       String?
  lastName        String?
  
  // Phase 4 enrollments
  classId         String?
  class           Class?    @relation("StudentClass", fields: [classId], references: [id])
  classTeacherOf  Class?    @relation("ClassTeacher")
  studentSubjects StudentSubject[]
  teacherSubjects TeacherSubjectClass[]
  reportCards     ReportCard[] @relation("StudentReportCards")
  
  // Parent invite
  inviteToken     String?   @unique
  
  // Account locking
  failedAttempts  Int       @default(0)
  lockedUntil     DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Creator relationship
  createdById     String?
  createdBy       User?     @relation("CreatedUsers", fields: [createdById], references: [id])
  createdUsers    User[]    @relation("CreatedUsers")
  
  auditActorLogs   AuditLog[]     @relation("AuditActor")
  auditTargetLogs  AuditLog[]     @relation("AuditTarget")
  childLinks       StudentParent[] @relation("StudentChildren")
  parentLinks      StudentParent[] @relation("ParentChildren")

  // Phase 2 relationships
  feeRecords       FeeRecord[]
  feeTransactions  FeeTransaction[]
  grades           Grade[]
  gradeAuditsActor GradeAuditLog[] @relation("GradeAuditActor")
  gradeAuditsAppr  GradeAuditLog[] @relation("GradeAuditApprover")
  attendanceRecords AttendanceRecord[]

  // Phase 3 relationships
  createdAssignments   Assignment[]            @relation("TeacherAssignments")
  submissions          AssignmentSubmission[]  @relation("StudentSubmissions")
  campaignsSent        CommunicationCampaign[] @relation("CampaignsSent")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  action      String
  targetId    String?
  details     String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User     @relation("AuditActor", fields: [actorId], references: [id])
  target      User?    @relation("AuditTarget", fields: [targetId], references: [id])
}

model StudentParent {
  id           String @id @default(uuid())
  studentId    String
  parentId     String
  relationship String?
  student      User   @relation("StudentChildren", fields: [studentId], references: [id])
  parent       User   @relation("ParentChildren", fields: [parentId], references: [id])
  @@unique([studentId, parentId])
}

// Phase 2 Models

model FeeRecord {
  id          String   @id @default(uuid())
  studentId   String
  term        String
  totalBilled Float
  amountPaid  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model FeeTransaction {
  id            String        @id @default(uuid())
  studentId     String
  amount        Float
  source        PaymentMethod
  receiptNumber String?       @unique
  status        String        @default("CONFIRMED")
  recordedById  String?
  createdAt     DateTime      @default(now())

  student       User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Class {
  id              String   @id @default(uuid())
  name            String   @unique
  level           Int?
  classTeacherId  String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  classTeacher    User?    @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  students        User[]   @relation("StudentClass")
  subjects        ClassSubject[]
  teacherSubjects TeacherSubjectClass[]
  assignments     Assignment[]
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grades      Grade[]
  assignments Assignment[] @relation("SubjectAssignments")
  classSubjects   ClassSubject[]
  studentSubjects StudentSubject[]
  teacherSubjects TeacherSubjectClass[]
  reportCardSubj  ReportCardSubject[]
}

model Grade {
  id              String      @id @default(uuid())
  studentId       String
  subjectId       String
  term            String
  value           String      // Can be numeric or CBC competency (EE, ME, etc.)
  status          GradeStatus @default(DRAFT)
  teacherComment  String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  student         User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  auditLogs       GradeAuditLog[]
}

model GradeAuditLog {
  id            String   @id @default(uuid())
  gradeId       String
  previousValue String?
  newValue      String
  changedById   String
  approvedById  String?
  reason        String?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt     DateTime @default(now())

  grade         Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  changedBy     User     @relation("GradeAuditActor", fields: [changedById], references: [id], onDelete: Cascade)
  approvedBy    User?    @relation("GradeAuditApprover", fields: [approvedById], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  studentId String
  date      DateTime
  status    AttendanceStatus
  lesson    String?          // e.g. "Math Period 1"
  createdAt DateTime         @default(now())

  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model TimetableSlot {
  id        String   @id @default(uuid())
  day       String   // e.g., "Monday"
  timeSlot  String   // e.g., "08:00-08:40"
  subjectId String
  teacherId String?
  classId   String
  createdAt DateTime @default(now())
}

// Phase 3 Enums

enum AssignmentType {
  QUIZ
  FILE_UPLOAD
}

enum QuestionType {
  MCQ
  OPEN_ENDED
}

enum SubmissionStatus {
  PENDING
  AUTO_GRADED
  MANUALLY_GRADED
}

enum CampaignType {
  SMS
  EMAIL
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

// Phase 3 Models

model Assignment {
  id          String         @id @default(uuid())
  title       String
  description String?
  type        AssignmentType
  subjectId   String?
  classId     String?
  teacherId   String
  dueDate     DateTime
  maxScore    Int            @default(100)
  isPublished Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  subject     Subject?       @relation("SubjectAssignments", fields: [subjectId], references: [id])
  class       Class?         @relation(fields: [classId], references: [id])
  teacher     User           @relation("TeacherAssignments", fields: [teacherId], references: [id])
  questions   QuizQuestion[]
  submissions AssignmentSubmission[]
}

model QuizQuestion {
  id            String       @id @default(uuid())
  assignmentId  String
  questionText  String
  questionType  QuestionType
  options       String?      // JSON stringified array for MCQ, e.g. ["A","B","C","D"]
  correctAnswer String?      // For MCQ auto-grading
  points        Int          @default(1)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())

  assignment    Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  responses     QuizResponse[]
}

model QuizResponse {
  id            String       @id @default(uuid())
  submissionId  String
  questionId    String
  answer        String
  isCorrect     Boolean?
  pointsAwarded Int?
  createdAt     DateTime     @default(now())

  submission    AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question      QuizQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  fileUrl      String?          // Cloudinary URL for file uploads
  textContent  String?          // For text-based submissions
  score        Float?
  maxScore     Float?
  status       SubmissionStatus @default(PENDING)
  feedback     String?
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?

  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User             @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  responses    QuizResponse[]
}

model CommunicationCampaign {
  id              String         @id @default(uuid())
  type            CampaignType
  subject         String?        // Email subject
  message         String
  targetAudience  String         // e.g. "ALL_PARENTS", "CLASS:Grade8", "DEBTORS"
  recipientCount  Int            @default(0)
  status          CampaignStatus @default(DRAFT)
  sentById        String
  sentAt          DateTime?
  createdAt       DateTime       @default(now())

  sentBy          User           @relation("CampaignsSent", fields: [sentById], references: [id])
  logs            CommunicationLog[]
}

model CommunicationLog {
  id            String   @id @default(uuid())
  campaignId    String
  recipientId   String?
  recipientPhone String?
  recipientEmail String?
  status        String   @default("QUEUED") // QUEUED, SENT, FAILED, DELIVERED
  errorMessage  String?
  createdAt     DateTime @default(now())

  campaign      CommunicationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// Phase 4 Enrollments & Grading

model ClassSubject {
  id        String @id @default(uuid())
  classId   String
  subjectId String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@unique([classId, subjectId])
}

model StudentSubject {
  id        String @id @default(uuid())
  studentId String
  subjectId String
  student   User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  @@unique([studentId, subjectId])
}

model TeacherSubjectClass {
  id        String @id @default(uuid())
  teacherId String
  subjectId String
  classId   String
  teacher   User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  @@unique([teacherId, subjectId, classId])
}

model ReportCard {
  id              String   @id @default(uuid())
  studentId       String
  term            String
  totalScore      Float?
  rank            Int?
  adminRemark     String?
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  student         User     @relation("StudentReportCards", fields: [studentId], references: [id], onDelete: Cascade)
  subjectGrades   ReportCardSubject[]
}

model ReportCardSubject {
  id            String   @id @default(uuid())
  reportCardId  String
  subjectId     String
  gradeValue    String   // numeric score or letter grade
  teacherRemark String?
  
  reportCard    ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subject       Subject    @relation(fields: [subjectId], references: [id])
}
